# Dedicated signing secret for ELP identity + voice gateway tokens. Use 32+ random bytes in production.
ELP_SESSION_SECRET=

# Reasoning provider: Hermes takes precedence when HERMES_BASE_URL is set.
# If neither Hermes nor Together is configured, ELP can still run a complete
# Deepgram-managed Voice Agent session.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Long-term user modeling
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=elp-gpt

# Composio external tools/actions. Use a scoped project API key where possible.
COMPOSIO_API_KEY=
COMPOSIO_API_URL=https://backend.composio.dev/api/v3.1

# Identity scope for Composio.
# Default: each ELP profile ID is the Composio user_id. This is the correct
# architecture for multi-user deployments where every user connects their own apps.
#
# Private owner deployment only: set ELP_SINGLE_USER_MODE=true. Preferred:
# bind each authenticated toolkit directly to its Composio connected account ID.
# Example:
# GMAIL=gmail_xxx,GOOGLECALENDAR=googlecalendar_xxx,GOOGLEDRIVE=googledrive_xxx
# This avoids relying on an opaque Composio owner user_id. A legacy owner user ID
# remains supported as a fallback. Never enable owner mode on a public/multi-user deployment.
ELP_SINGLE_USER_MODE=false
ELP_COMPOSIO_OWNER_ACCOUNT_BINDINGS=
ELP_COMPOSIO_OWNER_USER_ID=

# Stable single-user profile used by both the browser and headless JARBIS jobs.
# Only used when ELP_SINGLE_USER_MODE=true.
ELP_OWNER_PROFILE_ID=owner

# JARBIS autonomous daily briefing. Vercel invokes the protected cron twice around
# the Toronto DST boundary; only the invocation matching this local hour executes.
CRON_SECRET=
ELP_BRIEFING_TIMEZONE=America/Toronto
ELP_BRIEFING_HOUR=8

# Optional outbound delivery. Keep disabled unless the owner explicitly opts in.
# When enabled, the cron sends the generated daily briefing through the bound Gmail account.
ELP_BRIEFING_EMAIL_ENABLED=false
ELP_BRIEFING_EMAIL_TO=

# Optional defense-in-depth allowlist. Leave blank to allow every toolkit exposed
# by the configured Composio project. For production, explicitly list only the
# toolkits ELP is allowed to discover/execute.
# Phone calling is intentionally omitted while telephony is deferred.
# Example: GMAIL,GOOGLECALENDAR,GOOGLEDRIVE,COMPOSIO_SEARCH,YELP,GITHUB
ELP_ALLOWED_TOOLKITS=

# Deepgram realtime voice. Keep DEEPGRAM_API_KEY server-side only.
DEEPGRAM_API_KEY=
DEEPGRAM_API_URL=https://api.deepgram.com
DEEPGRAM_AGENT_URL=

# Flux v2 listening with multilingual English/Portuguese bias and tuned turn detection.
ELP_LISTEN_MODEL=flux-general-multi
ELP_LISTEN_LANGUAGE_HINTS=en,pt
ELP_LISTEN_KEYTERMS=ELP,ELP GPT,Deepgram,Hermes,Honcho,Together AI
ELP_EOT_THRESHOLD=0.78
ELP_EAGER_EOT_THRESHOLD=0.50
ELP_EOT_TIMEOUT_MS=2600

# Flux v2 text-to-speech. Supported Flux speed values are discrete.
ELP_VOICE_MODEL=flux-cliff-en
ELP_VOICE_SPEED=1.0

# Used only when Hermes/Together are not configured.
ELP_DEEPGRAM_MANAGED_LLM_MODEL=gpt-5-mini
