# Dedicated signing secret for LUKE identity + voice gateway tokens. Use 32+ random bytes in production.
LUKE_SESSION_SECRET=

# Reasoning provider: Hermes takes precedence when HERMES_BASE_URL is set.
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Long-term user modeling
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=elp-gpt-luke

# Realtime voice. Keep these server-side only.
DEEPGRAM_API_KEY=
LUKE_LISTEN_MODEL=flux-general-en
LUKE_VOICE_MODEL=aura-2-jupiter-en
